<%- include('partials/head', { pageTitle: 'بازبینی و ارسال', subtitle: 'گام پایانی فرم استخدام', company: company, backUrl: null }) %>

<div class="public-card">
  <div class="public-head">
    <div style="flex:1">
      <div style="font-weight:700"><%- icon('check-circle', '', 18) %> بازبینی نهایی اطلاعات</div>
      <div class="muted small">لطفاً اطلاعات زیر را بررسی کنید؛ پس از ارسال، امکان ویرایش توسط شما وجود ندارد (اصلاح با هماهنگی منابع انسانی انجام می‌شود).</div>
    </div>
    <span class="badge success">گام آخر</span>
  </div>

  <div class="public-body-inner">
    <% if (missing && missing.length) { %>
      <div class="alert alert-danger">
        <%- icon('alert') %>
        <div>
          <b>این موارد اجباری تکمیل نشده است:</b>
          <ul style="margin:.4rem 0 0 1rem"><% missing.forEach(function (m) { %><li><%= h.escapeHtml(m) %></li><% }); %></ul>
          <a class="btn btn-sm mt-1" href="/apply/<%= invite.token %>/form">تکمیل فرم</a>
        </div>
      </div>
    <% } %>

    <% (groups || []).forEach(function (g) { %>
      <div class="card" style="box-shadow:none">
        <div class="card-header"><h3><%- icon(g.icon || 'file-text') %> <%= h.escapeHtml(g.title) %></h3>
          <div class="actions"><a class="btn btn-sm" href="/apply/<%= invite.token %>/form">ویرایش</a></div>
        </div>
        <div class="card-body tight">
          <div class="dl">
            <% g.rows.forEach(function (a) { %>
              <div class="item">
                <span class="label"><%= h.escapeHtml(a.label) %><% if (a.row_index) { %> <span class="badge muted">ردیف <%= h.pnum(a.row_index + 1) %></span><% } %></span>
                <span class="value">
                  <% if (a.file) { %><a class="link" href="/files/<%= h.escapeHtml(a.file) %>" target="_blank">مشاهده فایل پیوست</a>
                  <% } else { %><%= h.escapeHtml(a.value || '—') %><% } %>
                </span>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    <% }); %>

    <% if (!groups || !groups.length) { %>
      <div class="empty-state"><%- icon('inbox', '', 40) %><p class="muted">هنوز اطلاعاتی ثبت نشده است.</p>
        <a class="btn btn-primary" href="/apply/<%= invite.token %>/form">شروع تکمیل فرم</a></div>
    <% } %>

    <form method="post" action="/apply/<%= invite.token %>/submit" data-guard class="mt-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card" style="box-shadow:none">
        <div class="card-body">
          <label class="check">
            <input type="checkbox" name="consent" value="1" required>
            <span class="check-label">
              صحت تمام اطلاعات واردشده را تأیید می‌کنم و موافقم اطلاعاتم برای بررسی استخدام در اختیار منابع انسانی قرار گیرد.
              <% if (consentText) { %><span class="muted small">(<%= h.escapeHtml(consentText) %>)</span><% } %>
            </span>
          </label>
          <div class="mt-2">
            <button class="btn btn-primary btn-lg" type="submit"><%- icon('send', '', 17) %> ارسال نهایی فرم استخدام</button>
          </div>
          <div class="muted small mt-1">پس از ارسال، کد پیگیری نمایش داده می‌شود؛ آن را نزد خود نگه دارید.</div>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('partials/foot', { company: company }) %>
