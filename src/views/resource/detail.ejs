<%
  var h = locals.h;
  var groups = [];
  (def.fields || []).forEach(function (f) {
    if (f.type === 'hidden') return;
    var g = f.group || 'اطلاعات اصلی';
    if (!groups.find(function (x) { return x.name === g; })) groups.push({ name: g, fields: [], icon: f.groupIcon || 'file-text' });
    groups.find(function (x) { return x.name === g; }).fields.push(f);
  });
%>
<div class="card">
  <div class="card-header">
    <div class="profile-header" style="flex:1">
      <% if (row.photo || row.avatar) { %>
        <span class="avatar lg"><img src="/files/<%= encodeURIComponent(row.photo || row.avatar) %>" alt=""></span>
      <% } else if (def.showAvatar) { %>
        <span class="avatar lg" style="background: <%= h.colorFromString(title) %>"><%= h.escapeHtml(h.initials(title)) %></span>
      <% } %>
      <div class="info">
        <div class="name"><%= h.escapeHtml(title) %></div>
        <div class="meta-row">
          <% (def.detailMeta || []).forEach(function (m) { %>
            <span class="item"><%- icon(m.icon || 'info', '', 15) %> <%= m.render(row, locals) %></span>
          <% }); %>
          <span class="item"><%- icon('hash', '', 15) %> شناسه: <%= h.pnum(row.id) %></span>
          <% if (row.created_at) { %><span class="item"><%- icon('clock', '', 15) %> ایجاد: <%= j.formatJalaali(row.created_at) %></span><% } %>
        </div>
      </div>
    </div>
    <div class="actions">
      <% if (canEdit) { %><a class="btn btn-primary" href="/<%= basePath %>/<%= row.id %>/edit"><%- icon('edit', '', 16) %> ویرایش</a><% } %>
      <a class="btn" href="/<%= basePath %>"><%- icon('arrow-right', '', 16) %> بازگشت به فهرست</a>
      <% if (canDelete) { %>
        <form method="post" action="/<%= basePath %>/<%= row.id %>/delete" style="display:inline" data-confirm="آیا از حذف این رکورد اطمینان دارید؟">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-danger btn-icon" type="submit" title="حذف"><%- icon('trash', '', 16) %></button>
        </form>
      <% } %>
    </div>
  </div>

  <% if (def.detailBadges) { %>
    <div class="card-body" style="padding-bottom:0">
      <%= def.detailBadges(row, h, j) %>
    </div>
  <% } %>

  <div class="card-body">
    <% groups.forEach(function (group) { %>
      <h4 style="display:flex;align-items:center;gap:.4rem;margin-top:1.2rem"><%- icon(group.icon, '', 17) %> <%= h.escapeHtml(group.name) %></h4>
      <dl class="dl">
        <% group.fields.forEach(function (f) { %>
          <% if (f.type === 'hidden' || f.type === 'static' && f.hideInDetail) return; %>
          <div>
            <dt><%= h.escapeHtml(f.label) %></dt>
            <dd><%- detailField(f) %></dd>
          </div>
        <% }); %>
      </dl>
    <% }); %>
  </div>
</div>

<% if (extra && extra.sections) { %>
  <% extra.sections.forEach(function (sec) { %>
    <div class="card">
      <div class="card-header"><h3><%- icon(sec.icon || 'list') %> <%= h.escapeHtml(sec.title) %></h3>
        <div class="actions"><%= sec.actions || '' %></div>
      </div>
      <div class="card-body <%= sec.flush ? 'tight' : '' %>"><%- sec.html %></div>
    </div>
  <% }); %>
<% } %>

<% if (extra && extra.timeline && extra.timeline.length) { %>
  <div class="card">
    <div class="card-header"><h3><%- icon('activity') %> تاریخچه</h3></div>
    <div class="card-body">
      <div class="timeline">
        <% extra.timeline.forEach(function (t) { %>
          <div class="timeline-item">
            <div class="title"><%= h.escapeHtml(t.title) %></div>
            <div class="time"><%= j.formatJalaaliFull(t.at) %><% if (t.by) { %> — <%= h.escapeHtml(t.by) %><% } %></div>
            <% if (t.body) { %><div class="muted small"><%= h.escapeHtml(t.body) %></div><% } %>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
<% } %>
