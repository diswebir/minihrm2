<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= appName %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="auth-shell">
  <div class="auth-card">
    <div class="brand"><div class="brand-logo">م</div></div>
    <h1>بازیابی گذرواژه</h1>
    <p class="sub">با شماره موبایل ثبت‌شده در سامانه، گذرواژه جدید تعیین کنید.</p>
    <% if (error) { %><div class="alert alert-danger"><%- icon('alert') %><div><%= error %></div></div><% } %>

    <% if (stage === 'request') { %>
      <form method="post" action="/forgot">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="field-label" for="mobile">شماره موبایل</label>
          <input type="tel" id="mobile" name="mobile" dir="ltr" required autofocus placeholder="09123456789">
        </div>
        <button class="btn btn-primary btn-block btn-lg" type="submit"><%- icon('smartphone', '', 18) %> ارسال کد بازیابی</button>
      </form>
    <% } else { %>
      <form method="post" action="/forgot/verify">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="mobile" value="<%= h.escapeHtml(mobile) %>">
        <div class="form-group">
          <label class="field-label">کد تأیید پیامکی</label>
          <input type="text" name="code" dir="ltr" required inputmode="numeric" placeholder="کد ۵ رقمی">
        </div>
        <div class="form-group">
          <label class="field-label" for="passwordInput">گذرواژه جدید</label>
          <input type="password" name="password" id="passwordInput" required autocomplete="new-password">
          <div class="strength-bar" id="strengthBar"></div>
          <span class="field-help" id="strengthLabel">حداقل ۸ کاراکتر</span>
        </div>
        <div class="form-group">
          <label class="field-label">تکرار گذرواژه جدید</label>
          <input type="password" name="password2" required autocomplete="new-password">
        </div>
        <button class="btn btn-primary btn-block btn-lg" type="submit"><%- icon('save', '', 18) %> تغییر گذرواژه</button>
      </form>
    <% } %>
    <div class="center mt-3"><a class="small" href="/login">بازگشت به صفحه ورود</a></div>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
