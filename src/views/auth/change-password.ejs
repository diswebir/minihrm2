<div class="card" style="max-width:620px;margin:auto">
  <div class="card-header"><h3><%- icon('key') %> تغییر گذرواژه</h3></div>
  <div class="card-body">
    <% if (force) { %>
      <div class="alert alert-warning"><%- icon('alert') %><div>برای ادامه کار، ابتدا گذرواژه خود را تغییر دهید. این کار برای امنیت حساب شما ضروری است.</div></div>
    <% } %>
    <% if (error) { %><div class="alert alert-danger"><%- icon('alert') %><div><%= error %></div></div><% } %>
    <form method="post" action="/profile/password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label class="field-label" for="current_password">گذرواژه فعلی</label>
        <input type="password" name="current_password" id="current_password" required autocomplete="current-password">
      </div>
      <div class="form-group">
        <label class="field-label" for="passwordInput">گذرواژه جدید</label>
        <input type="password" name="new_password" id="passwordInput" required autocomplete="new-password">
        <div class="strength-bar" id="strengthBar"><span></span></div>
        <span class="field-help" id="strengthLabel">حداقل ۸ کاراکتر شامل حروف و عدد</span>
      </div>
      <div class="form-group">
        <label class="field-label">تکرار گذرواژه جدید</label>
        <input type="password" name="new_password2" required autocomplete="new-password">
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" type="submit"><%- icon('save', '', 16) %> ذخیره</button>
        <a class="btn" href="/profile">انصراف</a>
      </div>
    </form>
  </div>
</div>
