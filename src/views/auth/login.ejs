<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= appName %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="auth-shell">
  <div class="auth-card">
    <div class="brand">
      <div class="brand-logo">م</div>
      <div class="brand-text">
        <strong><%= h.escapeHtml(appName) %></strong>
        <span><%= h.escapeHtml(tagline || '') %></span>
      </div>
    </div>

    <h1>ورود به حساب کاربری</h1>
    <p class="sub">برای استفاده از سامانه منابع انسانی، اطلاعات خود را وارد کنید.</p>

    <% if (installed) { %>
      <div class="alert alert-success"><%- icon('check-circle') %><div>نصب سامانه با موفقیت انجام شد. اکنون وارد شوید.</div></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger"><%- icon('alert') %><div><%= error %></div></div>
    <% } %>

    <div class="tabs" style="margin-bottom:1rem">
      <button class="tab <%= mode !== 'otp' ? 'active' : '' %>" type="button" onclick="location.href='/login'">گذرواژه</button>
      <% if (allowedOtp) { %>
        <button class="tab <%= mode === 'otp' ? 'active' : '' %>" type="button" onclick="location.href='/login?mode=otp'">ورود با پیامک</button>
      <% } %>
    </div>

    <% if (mode === 'otp' && allowedOtp) { %>
      <form method="post" action="/login/otp/request">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="field-label" for="mobile">شماره موبایل ثبت‌شده در سامانه</label>
          <input type="tel" id="mobile" name="mobile" dir="ltr" placeholder="09123456789" required autofocus inputmode="numeric">
          <span class="field-help">کد یک‌بارمصرف از طریق سامانه پیامکی برای شما ارسال می‌شود.</span>
        </div>
        <button class="btn btn-primary btn-block btn-lg" type="submit"><%- icon('smartphone', '', 18) %> دریافت کد تأیید</button>
      </form>
      <div class="auth-divider">یا</div>
      <a class="btn btn-block" href="/login"><%- icon('key', '', 17) %> ورود با نام کاربری و گذرواژه</a>
    <% } else { %>
      <form method="post" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="form-group">
          <label class="field-label" for="login">نام کاربری یا شماره موبایل</label>
          <input type="text" id="login" name="login" dir="ltr" required autofocus autocomplete="username" placeholder="username">
        </div>
        <div class="form-group">
          <label class="field-label" for="password">گذرواژه</label>
          <div class="input-group">
            <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••">
            <button class="btn btn-icon" type="button" data-toggle-password="password" title="نمایش گذرواژه"><%- icon('eye', '', 18) %></button>
          </div>
        </div>
        <div style="display:flex; align-items:center; gap:.5rem; margin-bottom:1rem">
          <label class="check" style="flex:1"><input type="checkbox" name="remember" value="1"><span class="check-label">مرا به خاطر بسپار</span></label>
          <a class="small" href="/forgot">گذرواژه را فراموش کرده‌ام</a>
        </div>
        <button class="btn btn-primary btn-block btn-lg" type="submit"><%- icon('log-in', '', 18) %> ورود به سامانه</button>
      </form>
      <% if (allowedOtp) { %>
        <div class="auth-divider">یا</div>
        <a class="btn btn-block" href="/login?mode=otp"><%- icon('smartphone', '', 17) %> ورود با رمز پیامکی</a>
      <% } %>
    <% } %>

    <div class="center mt-3">
      <a class="small" href="/careers"><%- icon('briefcase', '', 14) %> ورود داوطلبان استخدام (مشاهده موقعیت‌های شغلی)</a>
    </div>
  </div>
  <div class="center muted small mt-2"><%= h.escapeHtml(companyName || '') %> — <%= h.escapeHtml(appName) %> <%= h.pnum(appVersion) %></div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
