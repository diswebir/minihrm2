<%
  var h = locals.h;
  function renderActions(actions) {
    if (!actions || !actions.length) return '';
    return '<div class="row-actions">' + actions.map(function (a) {
      if (a.post) {
        return '<form method="post" action="' + a.url + '" style="display:inline"' +
          (a.confirm ? ' data-confirm="' + h.escapeHtml(a.confirm) + '"' : '') + '>' +
          '<input type="hidden" name="_csrf" value="' + csrfToken + '">' +
          (a.body ? Object.keys(a.body).map(function (k) { return '<input type="hidden" name="' + k + '" value="' + h.escapeHtml(a.body[k]) + '">'; }).join('') : '') +
          '<button class="btn btn-icon btn-sm" type="submit" title="' + h.escapeHtml(a.title || '') + '">' + icon(a.icon || 'more', '', 16) + '</button></form>';
      }
      return '<a class="btn btn-icon btn-sm" href="' + a.url + '" title="' + h.escapeHtml(a.title || '') + '">' + icon(a.icon || 'eye', '', 16) + '</a>';
    }).join('') + '</div>';
  }
%>
<div class="page-head">
  <div>
    <h1><%- icon(page.icon || 'grid') %> <%= h.escapeHtml(title) %></h1>
    <% if (page.subtitle) { %><p class="muted"><%= page.subtitle %></p><% } %>
  </div>
  <div class="page-actions">
    <% (page.actions || []).forEach(function (a) { %>
      <% if (a.post) { %>
        <form method="post" action="<%= a.url %>" style="display:inline" <%= a.confirm ? 'data-confirm="' + h.escapeHtml(a.confirm) + '"' : '' %>>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn <%= a.class || '' %>" type="submit"><%- icon(a.icon || 'check', '', 16) %> <%= h.escapeHtml(a.label) %></button>
        </form>
      <% } else { %>
        <a class="btn <%= a.class || '' %>" href="<%= a.url %>"<%= a.target ? ' target="' + a.target + '"' : '' %>><%- icon(a.icon || 'plus', '', 16) %> <%= h.escapeHtml(a.label) %></a>
      <% } %>
    <% }); %>
  </div>
</div>

<% if (page.kpis && page.kpis.length) { %>
  <div class="kpi-grid">
    <% page.kpis.forEach(function (k) { var tag = k.url ? 'a' : 'div'; %>
      <<%= tag %><%= k.url ? ' href="' + k.url + '"' : '' %> class="kpi-card kpi-<%= k.color %>">
        <span class="kpi-icon"><%- icon(k.icon, '', 22) %></span>
        <span class="kpi-body">
          <span class="kpi-value"><%= k.value %></span>
          <span class="kpi-label"><%= k.label %></span>
          <% if (k.hint || k.note) { %><span class="kpi-hint"><%= k.hint || k.note %></span><% } %>
        </span>
      </<%= tag %>>
    <% }); %>
  </div>
<% } %>

<% if (page.alerts && page.alerts.length) { %>
  <% page.alerts.forEach(function (a) { %>
    <div class="alert alert-<%= a.type || 'info' %>"><%- icon(a.type === 'danger' ? 'alert' : 'info') %><div><%= a.text %>
      <% if (a.url) { %> <a href="<%= a.url %>" class="link">مشاهده</a><% } %></div></div>
  <% }); %>
<% } %>

<% if (page.bars && page.bars.length) { %>
  <div class="card">
    <div class="card-header"><h3><%- icon('chart') %> <%= page.barsTitle || 'نمودار' %></h3></div>
    <div class="card-body">
      <div class="bars">
        <% var maxBar = Math.max.apply(null, page.bars.map(function (b) { return Number(b.value) || 0; }).concat([1])); %>
        <% page.bars.forEach(function (b) { %>
          <div class="bar-row">
            <span class="bar-label"><%= h.escapeHtml(b.label) %></span>
            <span class="bar-track"><span class="bar-fill bg-<%= b.color || 'primary' %>" style="width:<%= Math.round((Number(b.value) || 0) / maxBar * 100) %>%"></span></span>
            <span class="bar-value"><%= h.pnum(b.value || 0) %></span>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
<% } %>

<% (page.sections || []).forEach(function (sec) { %>
  <% if (sec.type === 'table') { %>
    <div class="card">
      <% if (sec.title) { %><div class="card-header"><h3><%- icon(sec.icon || 'list') %> <%= h.escapeHtml(sec.title) %></h3>
        <% if (sec.url) { %><div class="actions"><a class="btn btn-sm" href="<%= sec.url %>">مشاهده همه</a></div><% } %>
      </div><% } %>
      <div class="card-body <%= sec.compact ? 'tight' : '' %>">
        <% if (!sec.rows || !sec.rows.length) { %>
          <div class="empty-state" style="padding:1.6rem"><%- icon('inbox', '', 40) %><p class="muted"><%= sec.empty %></p></div>
        <% } else { %>
        <div class="table-wrap">
          <table class="table <%= sec.compact ? 'compact' : '' %>">
            <thead><tr>
              <% (sec.columns || []).forEach(function (c) { %><th class="<%= c.align ? 'ta-' + c.align : '' %>"><%= h.escapeHtml(c.label) %></th><% }); %>
              <% if ((sec.rows[0] && sec.rows[0].actions && sec.rows[0].actions.length)) { %><th class="ta-center">عملیات</th><% } %>
            </tr></thead>
            <tbody>
              <% sec.rows.forEach(function (r) { %>
                <tr>
                  <% (r.cells || []).forEach(function (cell, i) { %>
                    <td class="<%= (sec.columns[i] && sec.columns[i].align) ? 'ta-' + sec.columns[i].align : '' %><%= (sec.columns[i] && sec.columns[i].nowrap) ? ' nowrap' : '' %>"><%= cell %></td>
                  <% }); %>
                  <% if (r.actions && r.actions.length) { %><td class="ta-center"><%- renderActions(r.actions) %></td><% } %>
                </tr>
              <% }); %>
            </tbody>
            <% if (sec.sum) { %>
              <tfoot><tr>
                <% (sec.columns || []).forEach(function (c, i) { %>
                  <td><%= i === 0 ? 'جمع' : (sec.sum[i] !== undefined ? h.pnum(sec.sum[i]) : '') %></td>
                <% }); %>
                <% if (sec.rows[0] && sec.rows[0].actions && sec.rows[0].actions.length) { %><td></td><% } %>
              </tr></tfoot>
            <% } %>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  <% } else if (sec.type === 'tiles') { %>
    <div class="tile-grid">
      <% sec.items.forEach(function (t) { %>
        <a class="tile-card" href="<%= t.url %>">
          <span class="tile-icon bg-<%= t.color || 'primary' %>"><%- icon(t.icon || 'grid', '', 22) %></span>
          <span class="tile-body"><span class="tile-title"><%= h.escapeHtml(t.title) %></span>
            <% if (t.desc) { %><span class="tile-desc"><%= h.escapeHtml(t.desc) %></span><% } %>
            <% if (t.value !== undefined) { %><span class="tile-value"><%= h.pnum(t.value) %></span><% } %>
          </span>
        </a>
      <% }); %>
    </div>
  <% } else if (sec.type === 'list') { %>
    <div class="card">
      <% if (sec.title) { %><div class="card-header"><h3><%- icon(sec.icon) %> <%= h.escapeHtml(sec.title) %></h3>
        <% if (sec.url) { %><div class="actions"><a class="btn btn-sm" href="<%= sec.url %>">مشاهده همه</a></div><% } %></div><% } %>
      <div class="card-body">
        <% if (!sec.rows.length) { %><p class="muted center">موردی موجود نیست.</p><% } %>
        <ul class="list-plain">
          <% sec.rows.forEach(function (r) { %>
            <li>
              <%- icon(r.icon || 'dot', '', 16) %>
              <div style="flex:1">
                <div><% if (r.url) { %><a href="<%= r.url %>" class="link"><%= h.escapeHtml(r.title) %></a><% } else { %><%= h.escapeHtml(r.title) %><% } %></div>
                <% if (r.sub) { %><div class="muted small"><%= h.escapeHtml(r.sub) %></div><% } %>
              </div>
              <% if (r.meta) { %><span class="muted small nowrap"><%= h.escapeHtml(r.meta) %></span><% } %>
              <% if (r.badge) { %><%- r.badge %><% } %>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>
  <% } else if (sec.type === 'timeline') { %>
    <div class="card">
      <% if (sec.title) { %><div class="card-header"><h3><%- icon('activity') %> <%= h.escapeHtml(sec.title) %></h3></div><% } %>
      <div class="card-body">
        <div class="timeline">
          <% sec.items.forEach(function (t) { %>
            <div class="timeline-item">
              <div class="title"><%= h.escapeHtml(t.title) %></div>
              <div class="time"><%= t.time %><% if (t.by) { %> — <%= h.escapeHtml(t.by) %><% } %></div>
              <% if (t.body) { %><div class="muted small"><%= t.body %></div><% } %>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  <% } else if (sec.type === 'html') { %>
    <div class="card">
      <% if (sec.title) { %><div class="card-header"><h3><%- icon(sec.icon || 'grid') %> <%= h.escapeHtml(sec.title) %></h3>
        <div class="actions"><%= sec.actions || '' %></div></div><% } %>
      <div class="card-body <%= sec.flush ? 'tight' : '' %>"><%- sec.html %></div>
    </div>
  <% } else if (sec.type === 'form') { %>
    <div class="card">
      <% if (sec.title) { %><div class="card-header"><h3><%- icon(sec.icon || 'edit') %> <%= h.escapeHtml(sec.title) %></h3></div><% } %>
      <div class="card-body">
        <form method="<%= sec.method || 'post' %>" action="<%= sec.action %>" <%= sec.enctype ? 'enctype="' + sec.enctype + '"' : '' %> data-guard>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <%- sec.html %>
          <div class="btn-group mt-2"><button class="btn btn-primary" type="submit"><%- icon('save', '', 16) %> <%= sec.submit || 'ذخیره' %></button>
            <% if (sec.cancel) { %><a class="btn" href="<%= sec.cancel %>">انصراف</a><% } %></div>
        </form>
      </div>
    </div>
  <% } %>
<% }); %>
